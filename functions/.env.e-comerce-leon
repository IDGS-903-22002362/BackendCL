# Variables no secretas para deploy en proyecto e-comerce-leon (CI + firebase deploy).
# Firebase carga este archivo automaticamente: .env.<projectId>
# Debe incluir todos los origenes de PRODUCTION_CORS_ORIGINS: esta variable
# reemplaza (no extiende) los defaults de src/config/cors.config.ts.
CORS_ALLOWED_ORIGINS=https://ecomerce-next-front--e-comerce-leon.us-central1.hosted.app,https://tiendalaguarida.com,https://www.tiendalaguarida.com,https://clubleon.mx,https://www.clubleon.mx,https://developers.clubleon.mx,https://clubleon-developer-portal--e-comerce-leon.us-central1.hosted.app,http://localhost:3001,http://localhost:3002,http://localhost:9002
GCP_PROJECT_ID=e-comerce-leon
GCP_REGION=us-central1

# Gemini Developer API (Vertex Gemini desactivado)
AI_GEMINI_MODE=apiKey
GOOGLE_GENAI_USE_VERTEXAI=false
AI_GEMINI_API_VERSION=v1beta

# App Check: requiere NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY en frontend.
# Modo observacion; activar enforcement en un deploy dedicado.
APP_CHECK_ENFORCED=false

# --- Probador virtual (try-on) ---
AI_TRYON_ENABLED=true
AI_TRYON_CONSENT_VERSION=v1
AI_TRYON_USER_RATE_LIMIT_WINDOW_MS=3600000
AI_TRYON_USER_RATE_LIMIT_MAX=10
AI_TRYON_IDEMPOTENCY_WINDOW_MS=300000

# Stripe (publishable key vía GET /api/stripe/config; currency no es secreto)
STRIPE_PUBLISHABLE_KEY=pk_live_51TlczJQVAPvus3zFEkVFfo8a86rhExW4luLjHJ4OsX902ri7PLYEYbpRK7bRtYw2yttV5codkBOUQlidz7qSTXCW0066d2l0hi
STRIPE_CURRENCY=mxn

# Liga MX: cron cada hora; sync post-partido +3 h (America/Mexico_City)
